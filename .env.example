# SkillBridge AI — Backend Environment Variables
# Copy this file and rename to .env, then fill in the values

# Path to your Firebase service account JSON key file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Google Gemini API Key (for AI roadmap generation)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API Key (for fetching video resources)
# Get from: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Service Account JSON (for Google Sheets export) - base64 encoded or path
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# (Optional) PDF test file for running main.py locally
TEST_PDF_FILENAME=syllabus.pdf
